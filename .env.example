# ==========================================================
# VARIABLES DE ENTORNO - Control de Jornada Laboral
# Copia este archivo como ".env.local" (desarrollo) y
# configura las mismas variables en Vercel (produccion).
# ==========================================================

# --- Google Sheets (cuenta de servicio) -----------------------------------
# Email de la cuenta de servicio de Google Cloud (ver README seccion 2).
GOOGLE_SERVICE_ACCOUNT_EMAIL=nombre-cuenta@tu-proyecto.iam.gserviceaccount.com

# Clave privada de la cuenta de servicio. Debe copiarse TAL CUAL desde el
# JSON descargado, reemplazando los saltos de linea reales por "\n".
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# ID de la hoja de calculo de Google Sheets (se obtiene de la URL:
# https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit)
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# --- Autenticacion / sesiones -----------------------------------------------
# Cadena aleatoria larga y secreta usada para firmar las sesiones (JWT).
# Genera una con: openssl rand -base64 48
SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-muy-larga-y-secreta

# --- URL publica de la aplicacion -------------------------------------------
# Se usa para generar el codigo QR de acceso. En Vercel sera algo como
# https://tu-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Configuracion laboral ---------------------------------------------------
# Horas semanales a partir de las cuales se contabilizan horas extra.
WEEKLY_HOURS_LIMIT=42

# Zona horaria usada para calcular la fecha y hora "actuales" en el servidor.
APP_TIMEZONE=America/Bogota

# --- Usuario administrador inicial (solo para el script setup:admin) --------
INITIAL_ADMIN_NOMBRE="Administrador"
INITIAL_ADMIN_CARGO="Administrador del sistema"
INITIAL_ADMIN_USUARIO=admin
INITIAL_ADMIN_PASSWORD=CambiaEstaClave123
